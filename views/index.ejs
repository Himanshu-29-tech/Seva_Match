<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>SevaMatch - Community Support Platform</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      margin: 0;
      font-family: Arial;
      background: linear-gradient(135deg, #0f0f0f, #1a1a1a, #ffffff);
      min-height: 100vh;
      color: white;
    }

    .hero {
      text-align: center;
      padding: 80px 20px;
    }

    .title {
      font-size: 50px;
      font-weight: bold;
    }

    .subtitle {
      font-size: 18px;
      opacity: 0.8;
      margin-top: 10px;
    }

    .card-box {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.2);
      backdrop-filter: blur(10px);
      border-radius: 15px;
      padding: 25px;
      margin-top: 30px;
    }

    .btn-custom {
      margin: 10px;
      padding: 10px 25px;
      border-radius: 10px;
      font-weight: bold;
    }

    .section {
      max-width: 1000px;
      margin: auto;
      padding: 20px;
    }

    .feature {
      padding: 15px;
      border-radius: 12px;
      background: rgba(255,255,255,0.08);
      margin: 10px;
    }
  </style>
</head>

<body>

<!-- HERO SECTION -->
<div class="hero">

  <h1 class="title">🤝 SevaMatch</h1>
  <p class="subtitle">
    Connecting people in need with verified volunteers in real-time
  </p>

  <div class="mt-4">
    <a href="/dashboard" class="btn btn-success btn-custom">📊 Dashboard</a>
    <a href="/need-form" class="btn btn-danger btn-custom">🆘 Need Help</a>
    <a href="/volunteer-form" class="btn btn-primary btn-custom">🙋 Become Volunteer</a>
  </div>

</div>

<!-- ABOUT SECTION -->
<div class="section">

  <div class="card-box">
    <h3>🌍 About SevaMatch</h3>
    <p>
      SevaMatch is a smart community support system that connects people who need help
      with nearby volunteers instantly. Whether it's medical help, food delivery,
      transport, or emergency support — SevaMatch ensures help reaches fast.
    </p>
  </div>

  <!-- FEATURES -->
  <div class="row mt-4">

    <div class="col-md-4">
      <div class="feature">
        <h5>⚡ Smart Matching</h5>
        <p>AI-like algorithm finds best volunteers instantly.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="feature">
        <h5>📍 Location Based</h5>
        <p>Connects people based on nearby availability.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="feature">
        <h5>🤝 Community Driven</h5>
        <p>Built for real-world social impact.</p>
      </div>
    </div>

  </div>

  <!-- LOGIN SECTION (UI ONLY) -->
  <div class="card-box text-center mt-5">
  <h4>🔐 Login / Access Panel</h4>
  <p style="opacity:0.8;">
    Login to access dashboard and manage needs
  </p>

  <a href="/login" class="btn btn-warning btn-custom">
    Login
  </a>

  <a href="/register" class="btn btn-outline-light btn-custom">
    Register
  </a>
</div>

</div>

</body>
</html>