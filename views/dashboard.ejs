<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - SevaMatch</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background: linear-gradient(135deg, #0f0f0f 0%, #1a1a1a 50%, #ffffff 100%);
      min-height: 100vh;
      color: white;
      font-family: Arial, sans-serif;
    }

    .main-card {
      background: rgba(30, 30, 30, 0.95);
      border-radius: 16px;
      padding: 25px;
      border: 1px solid rgba(255,255,255,0.15);
      backdrop-filter: blur(10px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }

    .table th {
      background: rgba(255,255,255,0.08);
      color: white;
    }

    .badge-high {
      background-color: #dc3545;
    }

    .badge-medium {
      background-color: #ffc107;
      color: black;
    }

    .badge-low {
      background-color: #198754;
    }

    .section-title {
      font-weight: 700;
      margin-bottom: 20px;
    }

    .btn-home {
      border-radius: 10px;
      padding: 10px 20px;
    }

    pre {
      white-space: pre-wrap;
    }
  </style>
</head>
<body>

<div class="container mt-5">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>📊 SevaMatch Dashboard</h2>
    <a href="/" class="btn btn-outline-light btn-home">
      ← Back to Home
    </a>
  </div>

  <!-- NEEDS SECTION -->
  <div class="main-card mb-5">
    <h4 class="section-title">
      📋 All Community Needs (<%= needs.length %>)
    </h4>

    <% if (needs.length === 0) { %>

      <p class="text-center text-muted py-4">
        No needs submitted yet.
      </p>

    <% } else { %>

      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
          <thead>
            <tr>
              <th>Name</th>
              <th>Location</th>
              <th>Type</th>
              <th>Urgency</th>
              <th>Description</th>
              <th>Status</th>
              <th>Assign Volunteer</th>
              <th>AI Smart Match</th>
            </tr>
          </thead>

          <tbody>
            <% needs.forEach(need => { %>
              <tr>

                <td><%= need.name %></td>

                <td><%= need.location %></td>

                <td><%= need.type %></td>

                <td>
                  <span class="badge
                    <%= need.urgency === 'High'
                      ? 'badge-high'
                      : need.urgency === 'Medium'
                      ? 'badge-medium'
                      : 'badge-low' %>">

                    <%= need.urgency %>
                  </span>
                </td>

                <td>
                  <%= need.description.length > 70
                    ? need.description.substring(0, 70) + '...'
                    : need.description %>
                </td>

                <td>
                  <span class="badge
                    <%= need.status === 'Assigned'
                      ? 'bg-success'
                      : 'bg-warning text-dark' %>">

                    <%= need.status || 'Pending' %>
                  </span>
                </td>

                <!-- ASSIGN COLUMN -->
                <td>
                  <% if (need.status !== 'Assigned') { %>

                    <form
                      action="/assign"
                      method="POST"
                      style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;"
                    >

                      <input
                        type="hidden"
                        name="needId"
                        value="<%= need._id %>"
                      >

                      <select
                        name="volunteerId"
                        class="form-select"
                        style="min-width: 200px;"
                        required
                      >
                        <option value="">
                          Select Volunteer
                        </option>

                        <% volunteers.forEach(vol => { %>
                          <option value="<%= vol._id %>">
                            <%= vol.name %> - <%= vol.location %>
                          </option>
                        <% }) %>

                      </select>

                      <button
                        type="submit"
                        class="btn btn-success"
                      >
                        Assign
                      </button>

                    </form>

                  <% } else { %>

                    <span class="text-success fw-bold">
                      ✓ Assigned to
                      <%= need.assignedVolunteer || "Volunteer" %>
                    </span>

                  <% } %>
                </td>

                <!-- SMART MATCH BUTTON -->
                <td>
                  <a
                    href="/smart-match/<%= need._id %>"
                    class="btn btn-warning"
                  >
                    Smart Match
                  </a>
                </td>

              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    <% } %>
  </div>

  <!-- VOLUNTEERS SECTION -->
  <div class="main-card">
    <h4 class="section-title">
      👥 Registered Volunteers (<%= volunteers.length %>)
    </h4>

    <% if (volunteers.length === 0) { %>

      <p class="text-center text-muted py-4">
        No volunteers registered yet.
      </p>

    <% } else { %>

      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
          <thead>
            <tr>
              <th>Name</th>
              <th>Location</th>
              <th>Skills</th>
              <th>Availability</th>
            </tr>
          </thead>

          <tbody>
            <% volunteers.forEach(vol => { %>
              <tr>

                <td><%= vol.name %></td>

                <td><%= vol.location %></td>

                <td>
                  <%= vol.skills.length > 60
                    ? vol.skills.substring(0, 60) + '...'
                    : vol.skills %>
                </td>

                <td><%= vol.availability %></td>

              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    <% } %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>